# WarrantyVault Firebase Environment Configuration
# Copy this file to .env.local and populate with your Firebase console keys.
# If these variables are omitted, WarrantyVault automatically runs in Zero-Config Demo Mode.

NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your_app_id:web:your_web_id

# Optional Vision AI / OCR API keys for direct cloud extraction
NEXT_PUBLIC_OCR_API_KEY=your_ocr_api_key
